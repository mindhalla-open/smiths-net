[Unit]
Description=smiths-net — AI-first SIP engine
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/mindhalla-open/smiths-net

[Service]
Type=simple
ExecStart=/usr/local/bin/smiths-net --config /etc/smiths-net/config.toml
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
KillMode=mixed
# SIGTERM trips the graceful drain: new INVITEs get 503 + Retry-After: 0
# for SMITHS_DRAIN_SECS (default 5 s), then the process exits.
# `TimeoutStopSec` above gives up to 15 s before systemd escalates to
# SIGKILL; raise both together if your SLA demands a longer drain.
# Environment=SMITHS_DRAIN_SECS=10

# -- Identity + privileges --
User=smiths
Group=smiths
# CAP_NET_BIND_SERVICE lets the daemon bind to the well-known SIP
# ports (5060 / 5061) without running as root. Everything else the
# engine does (UDP sockets, reading config) needs no elevation.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# -- Filesystem sandbox --
# /etc/smiths-net mounted read-only — operators roll out config
# changes by re-deploying, not by hot-editing the live mount.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=
# Plugin spawn paths if the engine ever writes state; keep empty for
# the stateless MVP and uncomment if `[storage]` is enabled.
# ReadWritePaths=/var/lib/smiths-net
ReadOnlyPaths=/etc/smiths-net

# -- Syscall sandbox --
# Complements (not replaces) the per-plugin seccomp filter the engine
# installs on sidecars — this one scopes the engine itself.
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# The embedded WASM plugin host (wasmtime / Cranelift) JIT-compiles
# plugins: it maps code read-write, then flips the pages to
# read-execute with mprotect(2). MemoryDenyWriteExecute= forbids that
# transition (on current kernels through prctl(PR_SET_MDWE)), which
# makes every WASM plugin fail to load. Keep it off unless you run
# without WASM plugins.
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# -- Networking --
# IPv4 + IPv6 allowed; no UNIX sockets / netlink beyond what AF_INET
# + AF_INET6 need.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
