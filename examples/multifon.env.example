# Megafon Multifon SIP trunk — copy to examples/multifon.env
# and fill in. Do not commit passwords.
#
#   cp examples/multifon.env.example examples/multifon.env
#   source examples/multifon.env
#
# The AI stack (STT/LLM/TTS) is configured separately in examples/offline.env —
# fully offline: faster-whisper + llama.cpp/Gemma + Silero.

# --- Megafon Multifon SIP trunk ---
SIP_REALM=multifon.ru
SIP_REGISTRAR=sbc.megafon.ru
SIP_REGISTRAR_PORT=5060
SIP_REGISTER_EXPIRES=180
SIP_USERNAME=
SIP_PASSWORD=
# Provider number/DID (rendezvous key for inbound calls):
SIP_NUMBER=
# Public IP or FQDN that Megafon sees (Contact in REGISTER):
SIP_PUBLIC_ADDRESS=

# Transport: udp | tcp
SIP_TRANSPORT=udp

# Provider's preferred codec: PCMA (G.711 A-law)
SIP_PREFERRED_CODEC=PCMA
