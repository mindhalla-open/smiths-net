# Megafon Multifon SIP trunk — скопируйте в examples/multifon.env
# и заполните. Не коммитьте пароли.
#
#   cp examples/multifon.env.example examples/multifon.env
#   source examples/multifon.env
#
# AI-стек (STT/LLM/TTS) задаётся отдельно в examples/offline.env —
# полностью офлайн: faster-whisper + llama.cpp/Gemma + Silero.

# --- Megafon Multifon SIP trunk ---
SIP_REALM=multifon.ru
SIP_REGISTRAR=sbc.megafon.ru
SIP_REGISTRAR_PORT=5060
SIP_REGISTER_EXPIRES=180
SIP_USERNAME=
SIP_PASSWORD=
# Номер/DID от провайдера (rendezvous-ключ для входящих):
SIP_NUMBER=
# Публичный IP или FQDN, который видит Megafon (Contact в REGISTER):
SIP_PUBLIC_ADDRESS=

# Транспорт: udp | tcp
SIP_TRANSPORT=udp

# Предпочитаемый кодек провайдера: PCMA (G.711 A-law)
SIP_PREFERRED_CODEC=PCMA
