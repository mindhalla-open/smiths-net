# Полностью офлайновый профиль голосового ассистента (без сетевых API).
#
# Использование:
#   cp examples/offline.env.example examples/offline.env
#   # отредактируйте пути к моделям под свою машину
#   ./examples/restart-asr-bot.sh        # подхватит offline.env автоматически
#
# Турнкей-установка всех моделей и бинарей:
#   bash examples/setup-offline.sh

# ── Режим ────────────────────────────────────────────────────────
OFFLINE=1

# ── STT: faster-whisper large-v3 (CTranslate2, GPU) ──────────────
# Высокая точность на шумном 8 кГц телефонном тракте; полностью офлайн
# после первого кэширования модели в FW_DOWNLOAD_ROOT.
ASR_PLUGIN=ai-asr-faster-whisper
FW_MODEL=large-v3
FW_DEVICE=cuda
# int8_float16: веса int8, матобработка fp16 — ~1.5 ГБ меньше VRAM, чем
# float16, при сопоставимой точности (нужно, чтобы large-v3 поместился
# рядом с Gemma-2-9B на 12 ГБ GPU).
FW_COMPUTE_TYPE=int8_float16
FW_LANG=ru
FW_BEAM_SIZE=5
FW_VAD=1
FW_INITIAL_PROMPT="Телефонный разговор на русском языке."

# ── LLM: llama.cpp server + Gemma-2-9B-it Q4_K_M (GPU) ───────────
# Сервер запускается автоматически из restart-asr-bot.sh (start-llamacpp.sh).
LLM_PLUGIN=ai-llm-llamacpp
LLAMACPP_HOST=http://127.0.0.1:8081
LLAMACPP_MODEL=gemma
LLAMACPP_MODEL_PATH=/home/USER/.local/share/smiths-net/models/gemma-2-9b-it-Q4_K_M.gguf
LLAMACPP_TIMEOUT_SECS=180
LLM_MAX_TOKENS=160
# Только system + последние N реплик → стабильный префикс prompt-кэша.
LLM_HISTORY_MSGS=6
LLM_WARMUP=1
# GPU offload (RTX 4070 Ti, 12 ГБ): -ngl 99 = все слои на GPU.
LLAMACPP_NGL=99
LLAMACPP_CTX=2048

# ── TTS: Silero v5 (русский, GPU) ────────────────────────────────
TTS_PLUGIN=ai-tts-silero
SILERO_TTS=1
SILERO_MODEL=v5_5_ru
SILERO_SPEAKER=xenia
SILERO_THREADS=4
SILERO_DEVICE=cuda
# Альтернатива (легче, без PyTorch): Piper
#   TTS_PLUGIN=ai-tts-piper
#   PIPER_VOICE=/path/to/ru_RU-irina-medium.onnx
#   PIPER_VOICE_ID=irina

# ── VAD / захват речи ────────────────────────────────────────────
VAD_SILENCE_SECS=0.8
VAD_THRESHOLD=250
VAD_SPIKE_TOLERANCE=2
VAD_PRE_SPEECH_SECS=0.30
VAD_MIN_SPEECH_SECS=0.20
RECORD_SECS=10.0
# Спекулятивный turn-taking: начать готовить ответ после короткой паузы,
# отбросить, если абонент продолжил говорить. Должно быть < VAD_SILENCE_SECS.
VAD_SPECULATE_SILENCE_SECS=0.35

# ── Barge-in (перебивание бота голосом) ──────────────────────────
BARGE_IN=1
BARGE_THRESHOLD=900

# ── Персона ассистента: промпт, род, приветствие ─────────────────
BOT_CONFIG=examples/bot.toml
BOT_FILLERS_ENABLE=0

# ── Стабильность старта на симметричном RTP (Megafon) ────────────
RTP_PRIME_SECS=0.4
GREETING_LEAD_SILENCE_SECS=0.3

# ── Длина диалога ────────────────────────────────────────────────
BOT_MAX_TURNS=200
BOT_IDLE_TURNS_MAX=3
