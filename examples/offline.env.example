# Fully offline voice assistant profile (no network APIs).
#
# Usage:
#   cp examples/offline.env.example examples/offline.env
#   # edit the model paths to match your machine
#   ./examples/restart-asr-bot.sh        # picks up offline.env automatically
#
# Turnkey install of all models and binaries:
#   bash examples/setup-offline.sh

# ── Mode ─────────────────────────────────────────────────────────
OFFLINE=1

# ── STT: faster-whisper large-v3 (CTranslate2, GPU) ──────────────
# High accuracy on the noisy 8 kHz telephony path; fully offline
# after the model is cached once in FW_DOWNLOAD_ROOT.
ASR_PLUGIN=ai-asr-faster-whisper
FW_MODEL=large-v3
FW_DEVICE=cuda
# int8_float16: int8 weights, fp16 matmul — ~1.5 GB less VRAM than
# float16, at comparable accuracy (needed so large-v3 fits alongside
# Gemma-2-9B on a 12 GB GPU).
FW_COMPUTE_TYPE=int8_float16
FW_LANG=ru
FW_BEAM_SIZE=5
FW_VAD=1
FW_INITIAL_PROMPT="Телефонный разговор на русском языке."

# ── LLM: llama.cpp server + Gemma-2-9B-it Q4_K_M (GPU) ───────────
# The server starts automatically from restart-asr-bot.sh (start-llamacpp.sh).
LLM_PLUGIN=ai-llm-llamacpp
LLAMACPP_HOST=http://127.0.0.1:8081
LLAMACPP_MODEL=gemma
LLAMACPP_MODEL_PATH=/home/USER/.local/share/smiths-net/models/gemma-2-9b-it-Q4_K_M.gguf
LLAMACPP_TIMEOUT_SECS=180
LLM_MAX_TOKENS=160
# system + last N turns only → stable prompt-cache prefix.
LLM_HISTORY_MSGS=6
LLM_WARMUP=1
# GPU offload (RTX 4070 Ti, 12 GB): -ngl 99 = all layers on the GPU.
LLAMACPP_NGL=99
LLAMACPP_CTX=2048

# ── TTS: Silero v5 (Russian, GPU) ────────────────────────────────
TTS_PLUGIN=ai-tts-silero
SILERO_TTS=1
SILERO_MODEL=v5_5_ru
SILERO_SPEAKER=xenia
SILERO_THREADS=4
SILERO_DEVICE=cuda
# Alternative (lighter, no PyTorch): Piper
#   TTS_PLUGIN=ai-tts-piper
#   PIPER_VOICE=/path/to/ru_RU-irina-medium.onnx
#   PIPER_VOICE_ID=irina

# ── VAD / speech capture ─────────────────────────────────────────
VAD_SILENCE_SECS=0.8
VAD_THRESHOLD=250
VAD_SPIKE_TOLERANCE=2
VAD_PRE_SPEECH_SECS=0.30
VAD_MIN_SPEECH_SECS=0.20
RECORD_SECS=10.0
# Speculative turn-taking: start preparing a reply after a short pause,
# discard it if the caller keeps talking. Must be < VAD_SILENCE_SECS.
VAD_SPECULATE_SILENCE_SECS=0.35

# ── Barge-in (interrupting the bot with your voice) ──────────────
BARGE_IN=1
BARGE_THRESHOLD=900

# ── Assistant persona: prompt, gender, greeting ──────────────────
BOT_CONFIG=examples/bot.toml
BOT_FILLERS_ENABLE=0

# ── Startup stability on symmetric RTP (Megafon) ─────────────────
RTP_PRIME_SECS=0.4
GREETING_LEAD_SILENCE_SECS=0.3

# ── Dialogue length ──────────────────────────────────────────────
BOT_MAX_TURNS=200
BOT_IDLE_TURNS_MAX=3
