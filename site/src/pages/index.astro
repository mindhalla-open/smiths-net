---
/**
 * Landing page — docs hub with hero + section cards.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t, DEFAULT_LOCALE } from '@/i18n';

const locale = DEFAULT_LOCALE;

const sections = [
  { key: 'guide',        href: '/guide/',        icon: '🚀', color: 'hsl(142, 60%, 45%)' },
  { key: 'cookbook',      href: '/cookbook/',       icon: '📖', color: 'hsl(28, 92%, 56%)'  },
  { key: 'reference',    href: '/reference/',     icon: '📋', color: 'hsl(215, 80%, 58%)' },
  { key: 'operations',   href: '/operations/',    icon: '⚙️', color: 'hsl(270, 60%, 58%)' },
  { key: 'architecture', href: '/architecture/',  icon: '🏗️', color: 'hsl(340, 65%, 55%)' },
];
---

<BaseLayout
  title={t(locale, 'hero.title')}
  description={t(locale, 'hero.subtitle')}
  locale={locale}
>
  <!-- Hero -->
  <section class="hero" id="hero">
    <div class="container hero-inner">
      <div class="hero-badge">Open Source · Apache-2.0</div>
      <h1 class="hero-title" data-i18n="hero.title">{t(locale, 'hero.title')}</h1>
      <p class="hero-subtitle" data-i18n="hero.subtitle">{t(locale, 'hero.subtitle')}</p>
      <div class="hero-actions">
        <a href="/guide/quickstart/" class="btn btn--primary" data-i18n="hero.cta">{t(locale, 'hero.cta')}</a>
        <a
          href="https://github.com/friday-mindhalla/smiths-net"
          class="btn btn--secondary"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="hero.cta_secondary"
        >
          {t(locale, 'hero.cta_secondary')}
        </a>
      </div>
    </div>
  </section>

  <!-- Section cards -->
  <section class="sections" id="sections">
    <div class="container">
      <div class="section-grid">
        {sections.map(({ key, href, icon, color }) => (
          <a href={href} class="section-card" style={`--card-accent: ${color};`}>
            <span class="section-card-icon" aria-hidden="true">{icon}</span>
            <h2 class="section-card-title" data-i18n={`sections.${key}.title`}>{t(locale, `sections.${key}.title`)}</h2>
            <p class="section-card-desc" data-i18n={`sections.${key}.description`}>{t(locale, `sections.${key}.description`)}</p>
            <span class="section-card-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────── */
  .hero {
    position: relative;
    padding-block: var(--space-24) var(--space-16);
    text-align: center;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, hsla(28, 92%, 56%, 0.08) 0%, transparent 60%),
      radial-gradient(ellipse 60% 50% at 80% 20%, hsla(215, 80%, 58%, 0.06) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    max-width: 48rem;
  }

  .hero-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-4);
    margin-block-end: var(--space-6);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent-text);
    background: var(--color-accent-muted);
    border: 1px solid hsla(28, 60%, 40%, 0.3);
    border-radius: var(--radius-full);
  }

  .hero-title {
    font-size: var(--text-5xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    background: linear-gradient(
      135deg,
      var(--color-text) 0%,
      var(--color-accent) 50%,
      var(--color-secondary) 100%
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-block-end: var(--space-5);
  }

  .hero-subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 36rem;
    margin-inline: auto;
    margin-block-end: var(--space-10);
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* ── Buttons ─────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }

  .btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn--primary {
    color: hsl(228, 18%, 8%);
    background: var(--color-accent);
    box-shadow: var(--shadow-sm), 0 0 16px hsla(28, 92%, 56%, 0.2);
  }

  .btn--primary:hover {
    background: var(--color-accent-hover);
    box-shadow: var(--shadow-md), 0 0 24px hsla(28, 92%, 56%, 0.3);
    color: hsl(228, 18%, 8%);
  }

  .btn--secondary {
    color: var(--color-text);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
  }

  .btn--secondary:hover {
    background: var(--color-bg-hover);
    border-color: var(--color-text-faint);
    color: var(--color-text);
  }

  /* ── Section cards ──────────────────────────────── */
  .sections {
    padding-block: var(--space-4) var(--space-24);
  }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
  }

  .section-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-7);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-2xl);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    overflow: hidden;
  }

  .section-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 120% 80% at 100% 0%,
      color-mix(in srgb, var(--card-accent) 6%, transparent) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .section-card:hover {
    border-color: var(--card-accent);
    box-shadow: 0 0 0 1px var(--card-accent), var(--shadow-lg);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .section-card-icon {
    font-size: var(--text-3xl);
    margin-block-end: var(--space-4);
  }

  .section-card-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    margin-block-end: var(--space-2);
  }

  .section-card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    flex: 1;
  }

  .section-card-arrow {
    position: absolute;
    top: var(--space-6);
    right: var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-text-faint);
    transition: color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  [dir="rtl"] .section-card-arrow {
    right: auto;
    left: var(--space-6);
    transform: scaleX(-1);
  }

  .section-card:hover .section-card-arrow {
    color: var(--card-accent);
    transform: translateX(3px);
  }

  /* ── Responsive ──────────────────────────────────── */
  @media (max-width: 640px) {
    .hero {
      padding-block: var(--space-16) var(--space-12);
    }

    .hero-title {
      font-size: var(--text-3xl);
    }

    .hero-subtitle {
      font-size: var(--text-lg);
    }
  }
</style>
