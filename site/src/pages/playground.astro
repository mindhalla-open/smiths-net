---
/**
 * /playground — Interactive plugin validator.
 *
 * Embeds the Monaco editor with tabbed snippets for describe,
 * invoke, and manifest validation.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PlaygroundEditor from '@/components/PlaygroundEditor.astro';
---

<BaseLayout
  title="Plugin Playground — Smiths-Net"
  description="Interactive editor to validate your Smiths-Net plugin envelopes — describe, invoke, and manifest."
>
  <div class="playground-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href="/cookbook/">Cookbook</a>
      <span class="sep">/</span>
      <span class="current">Playground</span>
    </nav>

    <!-- Hero -->
    <header class="playground-hero">
      <div class="hero-badge">Interactive</div>
      <h1>Plugin Playground</h1>
      <p class="hero-desc">
        Edit plugin envelopes and validate them against the Smiths-Net
        contract — right in your browser. No engine needed.
      </p>
    </header>

    <!-- Editor -->
    <PlaygroundEditor />

    <!-- Help section -->
    <section class="playground-help">
      <h2>How it works</h2>
      <div class="help-grid">
        <div class="help-card">
          <div class="help-icon">📋</div>
          <h3>describe.json</h3>
          <p>
            Validates the JSON your plugin's <code>describe()</code> export
            returns. Must include <code>capability</code>, <code>plugin</code>,
            and <code>abi</code> fields.
          </p>
        </div>
        <div class="help-card">
          <div class="help-icon">⚡</div>
          <h3>invoke_response.json</h3>
          <p>
            Validates the JSON your <code>invoke()</code> returns. Must have
            either a <code>result</code> or an <code>error</code> envelope
            with <code>code</code> and <code>message</code>.
          </p>
        </div>
        <div class="help-card">
          <div class="help-icon">📦</div>
          <h3>plugin.toml</h3>
          <p>
            Validates the plugin manifest. Checks required fields
            (<code>name</code>, <code>version</code>, <code>type</code>,
            <code>entry</code>, <code>abi</code>) and type/entry consistency.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .playground-page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
  }

  /* ── Breadcrumb ─────────────────────────────────────────── */
  .breadcrumb {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumb a {
    color: var(--color-secondary);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .breadcrumb a:hover {
    color: var(--color-secondary-hover);
  }

  .breadcrumb .sep {
    color: var(--color-text-faint);
  }

  .breadcrumb .current {
    color: var(--color-text);
    font-weight: 500;
  }

  /* ── Hero ────────────────────────────────────────────────── */
  .playground-hero {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .hero-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    background: var(--color-accent-muted);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-4);
  }

  .playground-hero h1 {
    font-size: var(--text-4xl);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--space-4);
    line-height: var(--leading-tight);
  }

  .hero-desc {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 40rem;
    margin: 0 auto;
    line-height: var(--leading-relaxed);
  }

  /* ── Help ────────────────────────────────────────────────── */
  .playground-help {
    margin-top: var(--space-12);
  }

  .playground-help h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-bottom: var(--space-6);
    color: var(--color-text);
  }

  .help-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
  }

  .help-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: all var(--duration-normal) var(--ease-out);
  }

  .help-card:hover {
    border-color: var(--color-border);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .help-icon {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-3);
  }

  .help-card h3 {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-accent-text);
    margin-bottom: var(--space-3);
  }

  .help-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .help-card code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 0.15em 0.4em;
    background: var(--color-bg);
    border-radius: var(--radius-sm);
    color: var(--color-accent-text);
  }
</style>
