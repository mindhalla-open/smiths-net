---
/**
 * PlaygroundEditor — Monaco editor + plugin validator.
 *
 * Loads Monaco from CDN (bypasses Vite worker issues),
 * provides tabbed snippets for describe, invoke, and
 * manifest validation.
 */
---

<div class="playground" id="playground-root">
  <!-- Tab bar -->
  <div class="playground-tabs" role="tablist">
    <button class="tab active" role="tab" data-tab="describe" aria-selected="true" id="tab-describe">
      <span class="tab-icon">📋</span> describe.json
    </button>
    <button class="tab" role="tab" data-tab="invoke" aria-selected="false" id="tab-invoke">
      <span class="tab-icon">⚡</span> invoke_response.json
    </button>
    <button class="tab" role="tab" data-tab="manifest" aria-selected="false" id="tab-manifest">
      <span class="tab-icon">📦</span> plugin.toml
    </button>
  </div>

  <!-- Editor container -->
  <div class="playground-editor-wrap">
    <div id="monaco-container">
      <div class="editor-loading" id="editor-loading">
        <div class="loading-spinner"></div>
        <span>Loading editor…</span>
      </div>
    </div>
    <div class="editor-toolbar">
      <button class="btn-validate" id="btn-validate">
        <span class="btn-icon">▶</span> Validate
      </button>
      <span class="editor-hint" id="editor-hint">Edit the snippet, then click Validate</span>
    </div>
  </div>

  <!-- Output panel -->
  <div class="playground-output" id="playground-output">
    <div class="output-header">
      <span class="output-title">Validation Results</span>
      <span class="output-status" id="output-status"></span>
    </div>
    <div class="output-body" id="output-body">
      <p class="output-empty">Click <strong>Validate</strong> to check your plugin envelope.</p>
    </div>
  </div>
</div>

<style>
  .playground {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-surface);
  }

  /* ── Tabs ──────────────────────────────────────────────── */
  .playground-tabs {
    display: flex;
    gap: 0;
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-border);
    overflow-x: auto;
  }

  .tab {
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--duration-fast) var(--ease-out);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .tab:hover {
    color: var(--color-text);
    background: var(--color-bg-hover);
  }

  .tab.active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .tab-icon {
    font-size: var(--text-base);
  }

  /* ── Editor ─────────────────────────────────────────────── */
  .playground-editor-wrap {
    position: relative;
  }

  #monaco-container {
    height: 320px;
    min-height: 200px;
    position: relative;
  }

  .editor-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    background: var(--color-bg-surface);
  }

  .loading-spinner {
    width: 20px;
    height: 20px;
    border: 2px solid var(--color-border);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .editor-toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-elevated);
    border-top: 1px solid var(--color-border);
  }

  .btn-validate {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: #fff;
    background: linear-gradient(135deg, var(--color-accent), hsl(28, 92%, 46%));
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    box-shadow: var(--shadow-sm);
  }

  .btn-validate:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
    filter: brightness(1.1);
  }

  .btn-validate:active {
    transform: translateY(0);
  }

  .btn-icon {
    font-size: var(--text-base);
  }

  .editor-hint {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  /* ── Output ─────────────────────────────────────────────── */
  .playground-output {
    border-top: 1px solid var(--color-border);
    max-height: 300px;
    overflow-y: auto;
  }

  .output-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-border-subtle);
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .output-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .output-status {
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }

  .output-status.pass {
    color: var(--color-success);
    background: hsla(142, 60%, 48%, 0.12);
  }

  .output-status.fail {
    color: var(--color-error);
    background: hsla(0, 72%, 56%, 0.12);
  }

  .output-body {
    padding: var(--space-3) var(--space-4);
  }

  .output-empty {
    color: var(--color-text-faint);
    font-size: var(--text-sm);
    text-align: center;
    padding: var(--space-6) 0;
  }

  .check-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .check-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
  }

  .check-icon {
    flex-shrink: 0;
    width: 1.25rem;
    text-align: center;
  }

  .check-label {
    color: var(--color-text);
    font-weight: 500;
  }

  .check-detail {
    color: var(--color-text-faint);
    font-size: var(--text-xs);
    margin-inline-start: auto;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 200px;
  }
</style>

<script is:inline>
  // ── Validator (inline to avoid Vite import issues) ──────
  function validateDescribe(jsonString) {
    const checks = [];
    let data;
    try {
      data = JSON.parse(jsonString);
    } catch (e) {
      checks.push({ label: 'Valid JSON', pass: false, detail: e.message });
      return { ok: false, checks };
    }
    checks.push({ label: 'Valid JSON', pass: true });

    const descriptors = Array.isArray(data) ? data : [data];
    if (descriptors.length === 0) {
      checks.push({ label: 'At least one descriptor', pass: false, detail: 'Empty array' });
      return { ok: false, checks };
    }
    checks.push({ label: 'At least one descriptor', pass: true, detail: descriptors.length + ' descriptor(s)' });

    for (let i = 0; i < descriptors.length; i++) {
      const d = descriptors[i];
      const prefix = descriptors.length > 1 ? '[' + i + '] ' : '';

      const hasCapability = typeof d.capability === 'string' && d.capability.length > 0;
      checks.push({ label: prefix + 'Has "capability"', pass: hasCapability, detail: hasCapability ? d.capability : 'missing' });

      const hasPlugin = typeof d.plugin === 'string' && d.plugin.length > 0;
      checks.push({ label: prefix + 'Has "plugin"', pass: hasPlugin, detail: hasPlugin ? d.plugin : 'missing' });

      const hasAbi = typeof d.abi === 'string' && d.abi.length > 0;
      checks.push({ label: prefix + 'Has "abi"', pass: hasAbi, detail: hasAbi ? d.abi : 'missing' });

      if (d.description !== undefined) {
        const hasDesc = typeof d.description === 'string' && d.description.length > 0;
        checks.push({ label: prefix + 'Has "description"', pass: hasDesc });
      }
    }
    return { ok: checks.every(c => c.pass), checks };
  }

  function validateInvoke(jsonString) {
    const checks = [];
    let data;
    try {
      data = JSON.parse(jsonString);
    } catch (e) {
      checks.push({ label: 'Valid JSON', pass: false, detail: e.message });
      return { ok: false, checks };
    }
    checks.push({ label: 'Valid JSON', pass: true });

    if (typeof data !== 'object' || data === null || Array.isArray(data)) {
      checks.push({ label: 'Is an object', pass: false, detail: 'Got ' + typeof data });
      return { ok: false, checks };
    }
    checks.push({ label: 'Is an object', pass: true });

    const hasResult = 'result' in data;
    const hasError = 'error' in data;

    if (!hasResult && !hasError) {
      checks.push({ label: 'Has "result" or "error"', pass: false, detail: 'Neither found' });
      return { ok: false, checks };
    }
    if (hasResult && hasError) {
      checks.push({ label: 'Exclusive "result"/"error"', pass: false, detail: 'Both present' });
    } else {
      checks.push({ label: 'Has "result" or "error"', pass: true, detail: hasResult ? 'result' : 'error' });
    }

    if (hasError) {
      const err = data.error;
      const isObj = typeof err === 'object' && err !== null && !Array.isArray(err);
      checks.push({ label: 'Error is an object', pass: isObj });
      if (isObj) {
        const hasCode = typeof err.code === 'number';
        checks.push({ label: 'Error has numeric "code"', pass: hasCode, detail: hasCode ? 'code=' + err.code : 'missing' });
        const hasMsg = typeof err.message === 'string';
        checks.push({ label: 'Error has string "message"', pass: hasMsg, detail: hasMsg ? err.message : 'missing' });
      }
    }
    return { ok: checks.every(c => c.pass), checks };
  }

  function validateManifest(tomlString) {
    const checks = [];
    const fields = {};
    for (const line of tomlString.split('\n')) {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith('#')) continue;
      const eq = trimmed.indexOf('=');
      if (eq < 0) continue;
      const key = trimmed.slice(0, eq).trim();
      let val = trimmed.slice(eq + 1).trim();
      const ci = val.indexOf('#');
      if (ci > 0) val = val.slice(0, ci).trim();
      if ((val.startsWith('"') && val.endsWith('"')) || (val.startsWith("'") && val.endsWith("'"))) {
        val = val.slice(1, -1);
      }
      fields[key] = val;
    }
    checks.push({ label: 'Parseable TOML', pass: Object.keys(fields).length > 0 });

    for (const req of ['name', 'version', 'type', 'entry', 'abi']) {
      const val = fields[req];
      const has = typeof val === 'string' && val.length > 0;
      checks.push({ label: 'Has "' + req + '"', pass: has, detail: has ? val : 'missing' });
    }

    const validTypes = ['wasm', 'script', 'sidecar'];
    if (fields.type) {
      const validType = validTypes.includes(fields.type);
      checks.push({ label: 'Type is valid', pass: validType, detail: fields.type });
    }

    if (fields.type && fields.entry) {
      const ext = fields.entry.split('.').pop();
      const expectedExts = { wasm: 'wasm', script: 'rhai', sidecar: null };
      const expected = expectedExts[fields.type];
      if (expected) {
        const match = ext === expected;
        checks.push({ label: 'Entry ext matches type', pass: match, detail: match ? '.' + ext : 'expected .' + expected + ', got .' + ext });
      }
    }
    return { ok: checks.every(c => c.pass), checks };
  }

  // ── Snippets ────────────────────────────────────────────
  const SNIPPETS = {
    describe: {
      language: 'json',
      value: JSON.stringify({
        capability: 'ai.echo',
        plugin: 'my-plugin',
        abi: '1.0',
        description: 'Echo the method name back.',
      }, null, 2),
    },
    invoke: {
      language: 'json',
      value: JSON.stringify({
        result: 'echo: my-method',
      }, null, 2),
    },
    manifest: {
      language: 'plaintext',
      value: 'name        = "my-plugin"\nversion     = "0.1.0"\ntype        = "wasm"\nentry       = "./my_plugin.wasm"\nprovides    = ["ai.echo"]\npermissions = []\nabi         = "1.0"\ndescription = "My first plugin."',
    },
  };

  const validators = {
    describe: validateDescribe,
    invoke: validateInvoke,
    manifest: validateManifest,
  };

  let editor = null;
  let monacoLib = null;
  let activeTab = 'describe';
  const savedContent = {};

  // ── Load Monaco from CDN ────────────────────────────────
  function loadMonacoFromCDN() {
    return new Promise(function(resolve, reject) {
      if (window.monaco) {
        resolve(window.monaco);
        return;
      }

      const loaderScript = document.createElement('script');
      loaderScript.src = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs/loader.js';
      loaderScript.onload = function() {
        window.require.config({
          paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs' },
        });
        window.require(['vs/editor/editor.main'], function(monaco) {
          resolve(monaco);
        });
      };
      loaderScript.onerror = function() {
        reject(new Error('Failed to load Monaco editor from CDN'));
      };
      document.head.appendChild(loaderScript);
    });
  }

  async function initEditor() {
    try {
      monacoLib = await loadMonacoFromCDN();

      // Remove loading indicator
      const loading = document.getElementById('editor-loading');
      if (loading) loading.remove();

      // Detect theme
      const theme = document.documentElement.getAttribute('data-theme');
      const monacoTheme = theme === 'light' ? 'vs' : 'vs-dark';

      editor = monacoLib.editor.create(document.getElementById('monaco-container'), {
        value: SNIPPETS[activeTab].value,
        language: SNIPPETS[activeTab].language,
        theme: monacoTheme,
        fontSize: 14,
        fontFamily: "'JetBrains Mono', 'Fira Code', monospace",
        minimap: { enabled: false },
        lineNumbers: 'on',
        scrollBeyondLastLine: false,
        automaticLayout: true,
        padding: { top: 12, bottom: 12 },
        roundedSelection: true,
        cursorBlinking: 'smooth',
        smoothScrolling: true,
        tabSize: 2,
        wordWrap: 'on',
      });

      // Watch for theme changes
      const observer = new MutationObserver(function() {
        const t = document.documentElement.getAttribute('data-theme');
        monacoLib.editor.setTheme(t === 'light' ? 'vs' : 'vs-dark');
      });
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

      document.getElementById('editor-hint').textContent = 'Edit the snippet, then click Validate';
    } catch (err) {
      console.error('Monaco load error:', err);
      const container = document.getElementById('monaco-container');
      if (container) {
        container.innerHTML =
          '<div style="padding:2rem;text-align:center;color:var(--color-text-muted)">' +
          '<p>⚠️ Editor failed to load.</p>' +
          '<p style="font-size:0.875rem;margin-top:0.5rem">' + err.message + '</p></div>';
      }
    }
  }

  // ── Tab switching ───────────────────────────────────────
  document.querySelectorAll('.tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      if (editor) {
        savedContent[activeTab] = editor.getValue();
      }

      document.querySelectorAll('.tab').forEach(function(t) {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      activeTab = tab.dataset.tab;

      if (editor && monacoLib) {
        const content = savedContent[activeTab] || SNIPPETS[activeTab].value;
        const model = editor.getModel();
        if (model) {
          monacoLib.editor.setModelLanguage(model, SNIPPETS[activeTab].language);
        }
        editor.setValue(content);
      }

      clearOutput();
    });
  });

  // ── Validate ────────────────────────────────────────────
  document.getElementById('btn-validate').addEventListener('click', function() {
    if (!editor) return;
    const content = editor.getValue();
    const validate = validators[activeTab];
    if (!validate) return;
    renderOutput(validate(content));
  });

  function renderOutput(result) {
    const status = document.getElementById('output-status');
    const body = document.getElementById('output-body');

    status.textContent = result.ok ? '✅ PASS' : '❌ FAIL';
    status.className = 'output-status ' + (result.ok ? 'pass' : 'fail');

    var html = '<ul class="check-list">';
    for (var i = 0; i < result.checks.length; i++) {
      var c = result.checks[i];
      html += '<li class="check-item">';
      html += '<span class="check-icon">' + (c.pass ? '✅' : '❌') + '</span>';
      html += '<span class="check-label">' + escapeHtml(c.label) + '</span>';
      if (c.detail) {
        html += '<span class="check-detail" title="' + escapeHtml(c.detail) + '">' + escapeHtml(c.detail) + '</span>';
      }
      html += '</li>';
    }
    html += '</ul>';
    body.innerHTML = html;
  }

  function clearOutput() {
    var status = document.getElementById('output-status');
    var body = document.getElementById('output-body');
    status.textContent = '';
    status.className = 'output-status';
    body.innerHTML = '<p class="output-empty">Click <strong>Validate</strong> to check your plugin envelope.</p>';
  }

  function escapeHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  // ── Init ────────────────────────────────────────────────
  initEditor();
</script>
