---
/**
 * ProtocolExplorer — MCP/A2A JSON-RPC request/response builder.
 *
 * Tabbed interface with pre-built request templates for
 * MCP tools, MCP resources, and A2A agent cards.
 */
---

<div class="explorer" id="explorer-root">
  <!-- Tabs -->
  <div class="explorer-tabs" role="tablist">
    <button class="etab active" role="tab" data-tab="tools" id="etab-tools">🔧 MCP Tools</button>
    <button class="etab" role="tab" data-tab="resources" id="etab-resources">📁 MCP Resources</button>
    <button class="etab" role="tab" data-tab="a2a" id="etab-a2a">🤖 A2A Federation</button>
  </div>

  <!-- Tool selector + request/response -->
  <div class="explorer-body">
    <!-- Left: selector -->
    <div class="explorer-selector" id="explorer-selector">
      <div class="selector-header">Select a tool</div>
      <div class="selector-list" id="selector-list"></div>
    </div>

    <!-- Right: request + response -->
    <div class="explorer-panels">
      <div class="panel-pair">
        <div class="panel">
          <div class="panel-header">
            <span class="panel-badge panel-badge--req">Request</span>
            <span class="panel-method" id="panel-method">—</span>
          </div>
          <pre class="panel-body" id="panel-request"><code>// Select an item from the left panel</code></pre>
        </div>
        <div class="panel">
          <div class="panel-header">
            <span class="panel-badge panel-badge--res">Response</span>
          </div>
          <pre class="panel-body" id="panel-response"><code>// Response will appear here</code></pre>
        </div>
      </div>
      <div class="panel-desc" id="panel-desc"></div>
    </div>
  </div>
</div>

<style>
  .explorer {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-surface);
  }

  .explorer-tabs {
    display: flex;
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-border);
    overflow-x: auto;
  }

  .etab {
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .etab:hover { color: var(--color-text); background: var(--color-bg-hover); }
  .etab.active { color: var(--color-accent); border-bottom-color: var(--color-accent); }

  .explorer-body {
    display: grid;
    grid-template-columns: 220px 1fr;
    min-height: 420px;
  }

  @media (max-width: 768px) {
    .explorer-body { grid-template-columns: 1fr; }
  }

  /* ── Selector ───────────────────────────────────────── */
  .explorer-selector {
    border-inline-end: 1px solid var(--color-border);
    overflow-y: auto;
    max-height: 500px;
  }

  .selector-header {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-faint);
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .selector-list {
    display: flex;
    flex-direction: column;
  }

  .selector-item {
    display: block;
    width: 100%;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-border-subtle);
    cursor: pointer;
    text-align: start;
    transition: all var(--duration-fast);
  }

  .selector-item:hover { background: var(--color-bg-hover); color: var(--color-text); }
  .selector-item.active { color: var(--color-accent-text); background: var(--color-accent-muted); }

  /* ── Panels ─────────────────────────────────────────── */
  .explorer-panels {
    display: flex;
    flex-direction: column;
  }

  .panel-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    flex: 1;
  }

  @media (max-width: 768px) {
    .panel-pair { grid-template-columns: 1fr; }
  }

  .panel {
    display: flex;
    flex-direction: column;
    border-inline-end: 1px solid var(--color-border-subtle);
  }

  .panel:last-child { border-inline-end: none; }

  .panel-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .panel-badge {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }

  .panel-badge--req { color: hsl(215, 80%, 58%); background: hsl(215, 40%, 20%); }
  .panel-badge--res { color: hsl(142, 60%, 48%); background: hsl(142, 30%, 18%); }

  :global([data-theme="light"]) .panel-badge--req { background: hsl(215, 40%, 92%); }
  :global([data-theme="light"]) .panel-badge--res { background: hsl(142, 30%, 92%); }

  .panel-method {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .panel-body {
    flex: 1;
    padding: var(--space-4);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    background: var(--color-bg);
    overflow: auto;
    white-space: pre-wrap;
    max-height: 360px;
  }

  .panel-desc {
    padding: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    background: var(--color-bg-elevated);
    border-top: 1px solid var(--color-border-subtle);
    line-height: var(--leading-relaxed);
    min-height: 60px;
  }
</style>

<script is:inline>
  // ── Data ─────────────────────────────────────────────
  var DATA = {
    tools: [
      {
        name: 'make_call',
        desc: 'Initiate an outbound SIP call from the engine to a destination URI.',
        request: {
          jsonrpc: '2.0', id: 1,
          method: 'tools/call',
          params: { name: 'make_call', arguments: { from: 'sip:agent@engine.local', to: 'sip:alice@example.com', codec: 'opus' } },
        },
        response: {
          jsonrpc: '2.0', id: 1,
          result: { content: [{ type: 'text', text: 'Call initiated. Call-ID: abc123@engine.local' }] },
        },
      },
      {
        name: 'send_dtmf',
        desc: 'Send DTMF tones (RFC 4733) into an active call for IVR navigation.',
        request: {
          jsonrpc: '2.0', id: 2,
          method: 'tools/call',
          params: { name: 'send_dtmf', arguments: { call_id: 'abc123@engine.local', digits: '1234#', duration_ms: 160 } },
        },
        response: {
          jsonrpc: '2.0', id: 2,
          result: { content: [{ type: 'text', text: 'Sent 5 DTMF digits on call abc123@engine.local' }] },
        },
      },
      {
        name: 'get_config',
        desc: 'Read the current engine configuration as a TOML document.',
        request: {
          jsonrpc: '2.0', id: 3,
          method: 'tools/call',
          params: { name: 'get_config', arguments: { section: 'sip' } },
        },
        response: {
          jsonrpc: '2.0', id: 3,
          result: { content: [{ type: 'text', text: '[sip]\nlisten = "0.0.0.0:5060"\ntransport = "udp"\nmax_calls = 1000' }] },
        },
      },
      {
        name: 'put_config',
        desc: 'Update engine configuration with hot-reload. Changes take effect immediately.',
        request: {
          jsonrpc: '2.0', id: 4,
          method: 'tools/call',
          params: { name: 'put_config', arguments: { section: 'sip', values: { max_calls: 2000 } } },
        },
        response: {
          jsonrpc: '2.0', id: 4,
          result: { content: [{ type: 'text', text: 'Configuration updated. Hot-reload applied.' }] },
        },
      },
      {
        name: 'list_plugins',
        desc: 'List all loaded plugins with their status, capabilities, and version.',
        request: {
          jsonrpc: '2.0', id: 5,
          method: 'tools/call',
          params: { name: 'list_plugins', arguments: {} },
        },
        response: {
          jsonrpc: '2.0', id: 5,
          result: { content: [{ type: 'text', text: '3 plugins loaded:\n  hello-world (wasm) v0.1.0 — active\n  route-rhai (script) v0.1.0 — active\n  ai-sidecar (sidecar) v0.2.0 — active' }] },
        },
      },
      {
        name: 'reload_plugin',
        desc: 'Hot-reload a plugin without dropping active calls.',
        request: {
          jsonrpc: '2.0', id: 6,
          method: 'tools/call',
          params: { name: 'reload_plugin', arguments: { name: 'route-rhai' } },
        },
        response: {
          jsonrpc: '2.0', id: 6,
          result: { content: [{ type: 'text', text: 'Plugin route-rhai reloaded. 0 calls affected.' }] },
        },
      },
    ],
    resources: [
      {
        name: 'config://current',
        desc: 'Current engine configuration as a TOML document.',
        request: {
          jsonrpc: '2.0', id: 10,
          method: 'resources/read',
          params: { uri: 'config://current' },
        },
        response: {
          jsonrpc: '2.0', id: 10,
          result: { contents: [{ uri: 'config://current', mimeType: 'application/toml', text: '[sip]\nlisten = "0.0.0.0:5060"\n\n[webrtc]\nenabled = true\nstun = "stun:stun.l.google.com:19302"\n\n[plugins]\ndir = "./plugins"\nhot_reload = true' }] },
        },
      },
      {
        name: 'config://history',
        desc: 'Configuration change history with timestamps and diffs.',
        request: {
          jsonrpc: '2.0', id: 11,
          method: 'resources/read',
          params: { uri: 'config://history' },
        },
        response: {
          jsonrpc: '2.0', id: 11,
          result: { contents: [{ uri: 'config://history', mimeType: 'application/json', text: '[\n  {"ts":"2026-04-26T15:00:00Z","section":"sip","field":"max_calls","old":1000,"new":2000},\n  {"ts":"2026-04-26T14:30:00Z","section":"plugins","field":"hot_reload","old":false,"new":true}\n]' }] },
        },
      },
      {
        name: 'metrics://counters',
        desc: 'Live Prometheus-style counters for calls, errors, and media.',
        request: {
          jsonrpc: '2.0', id: 12,
          method: 'resources/read',
          params: { uri: 'metrics://counters' },
        },
        response: {
          jsonrpc: '2.0', id: 12,
          result: { contents: [{ uri: 'metrics://counters', mimeType: 'text/plain', text: 'smiths_calls_total{status="answered"} 1842\nsmiths_calls_total{status="failed"} 23\nsmiths_media_rtp_packets_total 984201\nsmiths_plugins_loaded 3\nsmiths_plugins_reloads_total 7' }] },
        },
      },
    ],
    a2a: [
      {
        name: 'Agent Card',
        desc: 'JSON agent card published at /.well-known/agent.json — describes capabilities for federation.',
        request: { note: 'GET /.well-known/agent.json' },
        response: {
          name: 'Smiths-Net Voice Agent',
          description: 'AI-first SIP/WebRTC telephony engine with MCP tool support.',
          url: 'https://engine.example.com',
          version: '0.1.0',
          capabilities: {
            tools: ['make_call', 'send_dtmf', 'get_config', 'put_config', 'list_plugins'],
            resources: ['config://current', 'config://history', 'metrics://counters'],
            streaming: true,
          },
          authentication: { schemes: ['bearer'] },
          defaultInputModes: ['text'],
          defaultOutputModes: ['text'],
        },
      },
      {
        name: 'Task: Send',
        desc: 'Send a task to a federated agent via the A2A protocol.',
        request: {
          jsonrpc: '2.0', id: 20,
          method: 'tasks/send',
          params: {
            id: 'task-001',
            message: { role: 'user', parts: [{ type: 'text', text: 'Call alice@example.com and play a greeting.' }] },
          },
        },
        response: {
          jsonrpc: '2.0', id: 20,
          result: {
            id: 'task-001',
            status: { state: 'working' },
            artifacts: [{ name: 'call_result', parts: [{ type: 'text', text: 'Calling alice@example.com...' }] }],
          },
        },
      },
      {
        name: 'Task: Status',
        desc: 'Check the status of a previously submitted task.',
        request: {
          jsonrpc: '2.0', id: 21,
          method: 'tasks/get',
          params: { id: 'task-001' },
        },
        response: {
          jsonrpc: '2.0', id: 21,
          result: {
            id: 'task-001',
            status: { state: 'completed' },
            artifacts: [{ name: 'call_result', parts: [{ type: 'text', text: 'Call completed. Duration: 45s. Transcription available.' }] }],
          },
        },
      },
    ],
  };

  var activeTab = 'tools';
  var activeItem = 0;

  function renderSelector(tab) {
    var list = document.getElementById('selector-list');
    var items = DATA[tab];
    var header = document.querySelector('.selector-header');

    if (tab === 'tools') header.textContent = 'Select a tool';
    else if (tab === 'resources') header.textContent = 'Select a resource';
    else header.textContent = 'Select a protocol';

    var html = '';
    for (var i = 0; i < items.length; i++) {
      html += '<button class="selector-item' + (i === 0 ? ' active' : '') + '" data-idx="' + i + '">' + escHtml(items[i].name) + '</button>';
    }
    list.innerHTML = html;

    // Wire clicks
    list.querySelectorAll('.selector-item').forEach(function(btn) {
      btn.addEventListener('click', function() {
        list.querySelectorAll('.selector-item').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        activeItem = parseInt(btn.dataset.idx);
        renderPanels();
      });
    });
  }

  function renderPanels() {
    var item = DATA[activeTab][activeItem];
    if (!item) return;

    document.getElementById('panel-method').textContent = item.request.method || item.request.note || '';
    document.getElementById('panel-request').innerHTML = '<code>' + escHtml(JSON.stringify(item.request, null, 2)) + '</code>';
    document.getElementById('panel-response').innerHTML = '<code>' + escHtml(JSON.stringify(item.response, null, 2)) + '</code>';
    document.getElementById('panel-desc').textContent = item.desc;
  }

  function escHtml(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // Tab switching
  document.querySelectorAll('.etab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      document.querySelectorAll('.etab').forEach(function(t) { t.classList.remove('active'); });
      tab.classList.add('active');
      activeTab = tab.dataset.tab;
      activeItem = 0;
      renderSelector(activeTab);
      renderPanels();
    });
  });

  // Init
  renderSelector('tools');
  renderPanels();
</script>
