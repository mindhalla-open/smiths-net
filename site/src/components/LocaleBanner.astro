---
/**
 * <LocaleBanner> — shown when a page falls back to `en` because
 * the requested locale's translation doesn't exist yet.
 */
import { t, DEFAULT_LOCALE } from '@/i18n';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
  pageLocale: Locale;
}

const { locale, pageLocale } = Astro.props;
const showBanner = locale !== DEFAULT_LOCALE && pageLocale === DEFAULT_LOCALE;
---

{showBanner && (
  <div class="locale-banner" role="alert">
    <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
      <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.168 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
    </svg>
    <span>{t(DEFAULT_LOCALE, 'recipe.not_translated')}</span>
  </div>
)}

<style>
  .locale-banner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    margin-block-end: var(--space-6);
    background: var(--color-accent-muted);
    border: 1px solid hsl(28, 60%, 32%);
    border-radius: var(--radius-md);
    color: var(--color-accent-text);
    font-size: var(--text-sm);
    font-weight: 500;
  }
</style>
