---
/**
 * <Header> — top navigation bar with logo, track links, and GitHub link.
 */
import { t, DEFAULT_LOCALE, SUPPORTED_LOCALES } from '@/i18n';
import type { Locale } from '@/i18n';

const LOCALE_LABELS: Record<string, { flag: string; name: string }> = {
  en: { flag: '🇬🇧', name: 'English' },
  ru: { flag: '🇷🇺', name: 'Русский' },
  es: { flag: '🇪🇸', name: 'Español' },
  zh: { flag: '🇨🇳', name: '中文' },
  ar: { flag: '🇸🇦', name: 'العربية' },
};
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a href="/" class="header-logo" aria-label={t(locale, 'site.title')}>
      <svg class="header-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" aria-hidden="true">
        <path d="M12 2L2 7l10 5 10-5-10-5z" />
        <path d="M2 17l10 5 10-5" />
        <path d="M2 12l10 5 10-5" />
      </svg>
      <span class="header-logo-text">Smiths-Net</span>
    </a>

    <nav class="header-nav" aria-label="Main navigation">
      <a href="/guide/" class="header-link" data-i18n="nav.guide">{t(locale, 'nav.guide')}</a>
      <a href="/cookbook/" class="header-link" data-i18n="nav.cookbook">{t(locale, 'nav.cookbook')}</a>
      <a href="/demo/" class="header-link header-link--demo">Demo</a>
      <a href="/reference/" class="header-link" data-i18n="nav.reference">{t(locale, 'nav.reference')}</a>
      <a href="/operations/" class="header-link" data-i18n="nav.operations">{t(locale, 'nav.operations')}</a>
      <a href="/architecture/" class="header-link" data-i18n="nav.architecture">{t(locale, 'nav.architecture')}</a>
      <a
        href="https://github.com/friday-mindhalla/smiths-net"
        class="header-link header-link--github"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 16 16" fill="currentColor" width="16" height="16" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
        </svg>
        <span data-i18n="nav.github">{t(locale, 'nav.github')}</span>
      </a>
      <button
        class="header-search"
        type="button"
        data-search-trigger
        aria-label="Search (⌘K)"
        title="Search (⌘K)"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <span class="header-search-kbd">⌘K</span>
      </button>
      <div class="locale-picker" id="locale-picker">
        <button
          class="locale-btn"
          type="button"
          aria-label="Change language"
          aria-expanded="false"
          id="locale-trigger"
        >
          <span class="locale-flag">{LOCALE_LABELS[locale]?.flag ?? '🌐'}</span>
          <svg class="locale-chevron" viewBox="0 0 16 16" fill="currentColor" width="10" height="10" aria-hidden="true">
            <path d="M4.427 6.427a.75.75 0 011.06-.073L8 8.574l2.513-2.22a.75.75 0 11.994 1.126l-3.01 2.66a.75.75 0 01-.994 0l-3.01-2.66a.75.75 0 01-.066-1.073z" />
          </svg>
        </button>
        <div class="locale-dropdown" id="locale-dropdown" role="listbox" aria-label="Languages">
          {SUPPORTED_LOCALES.map((loc) => (
            <button
              class={`locale-option ${loc === locale ? 'active' : ''}`}
              role="option"
              aria-selected={loc === locale ? 'true' : 'false'}
              data-locale={loc}
            >
              <span class="locale-option-flag">{LOCALE_LABELS[loc]?.flag}</span>
              <span class="locale-option-name">{LOCALE_LABELS[loc]?.name}</span>
              {loc === locale && <span class="locale-check">✓</span>}
            </button>
          ))}
        </div>
      </div>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-height);
    background: hsla(228, 18%, 8%, 0.85);
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    border-block-end: 1px solid var(--color-border-subtle);
    transition: background var(--duration-normal) var(--ease-out);
  }

  :global([data-theme="light"]) .site-header {
    background: hsla(220, 20%, 98%, 0.85);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    font-weight: 700;
    font-size: var(--text-lg);
    text-decoration: none;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .header-logo:hover {
    opacity: 0.8;
    text-decoration: none;
  }

  .header-logo-icon {
    color: var(--color-accent);
  }

  .header-logo-text {
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-text));
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .header-link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .header-link:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  .header-link--github {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  @media (max-width: 640px) {
    .header-link--github span {
      display: none;
    }
  }

  .header-search {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .header-search:hover {
    color: var(--color-text);
    border-color: var(--color-text-faint);
    background: var(--color-bg-hover);
  }

  .header-search-kbd {
    font-size: var(--text-xs);
    font-family: var(--font-sans);
    padding: 0.1em 0.4em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-elevated);
    color: var(--color-text-faint);
    line-height: 1;
  }

  @media (max-width: 640px) {
    .header-search-kbd {
      display: none;
    }
  }
  /* ── Locale picker ─────────────────────────────── */
  .locale-picker {
    position: relative;
  }

  .locale-btn {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    line-height: 1;
  }

  .locale-btn:hover {
    border-color: var(--color-text-faint);
    background: var(--color-bg-hover);
    color: var(--color-text);
  }

  .locale-flag { font-size: 16px; }

  .locale-chevron {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .locale-picker.open .locale-chevron {
    transform: rotate(180deg);
  }

  .locale-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 150px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-1) 0;
    z-index: 200;
  }

  .locale-picker.open .locale-dropdown {
    display: block;
    animation: dropdown-in 0.15s var(--ease-out);
  }

  @keyframes dropdown-in {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .locale-option {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-2) var(--space-3);
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    cursor: pointer;
    text-align: start;
    transition: all var(--duration-fast);
  }

  .locale-option:hover {
    background: var(--color-bg-hover);
    color: var(--color-text);
  }

  .locale-option.active {
    color: var(--color-accent-text);
    font-weight: 600;
  }

  .locale-option-flag { font-size: 16px; }

  .locale-check {
    margin-inline-start: auto;
    color: var(--color-accent);
    font-size: var(--text-xs);
  }
</style>

<script>
  // Import locale data at build time
  import enData from '../i18n/en.json';
  import ruData from '../i18n/ru.json';
  import arData from '../i18n/ar.json';
  import zhData from '../i18n/zh.json';
  import esData from '../i18n/es.json';

  const LOCALES: Record<string, Record<string, unknown>> = {
    en: enData,
    ru: ruData,
    ar: arData,
    zh: zhData,
    es: esData,
  };

  const FLAGS: Record<string, string> = {
    en: '🇬🇧', ru: '🇷🇺', es: '🇪🇸', zh: '🇨🇳', ar: '🇸🇦',
  };

  const STORAGE_KEY = 'smiths-locale';
  const RTL_LOCALES = new Set(['ar']);
  const CJK_LOCALES = new Set(['zh']);

  /** Resolve a dotted key against a nested object. */
  function resolve(obj: Record<string, unknown>, path: string): string | undefined {
    const parts = path.split('.');
    let current: unknown = obj;
    for (const part of parts) {
      if (current === null || typeof current !== 'object') return undefined;
      current = (current as Record<string, unknown>)[part];
    }
    return typeof current === 'string' ? current : undefined;
  }

  /** Swap all data-i18n elements to the target locale. */
  function applyLocale(locale: string) {
    const map = LOCALES[locale] ?? LOCALES.en;
    const fallback = LOCALES.en;

    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (!key) return;
      let text = resolve(map, key) ?? resolve(fallback, key);
      if (!text) return;
      // Support template substitution: data-i18n-replace="{year}" data-i18n-value="2026"
      const replacePattern = (el as HTMLElement).dataset.i18nReplace;
      const replaceValue = (el as HTMLElement).dataset.i18nValue;
      if (replacePattern && replaceValue) {
        text = text.replace(replacePattern, replaceValue);
      }
      el.textContent = text;
    });

    // Update flag in the picker button
    const flag = document.querySelector('.locale-flag');
    if (flag) flag.textContent = FLAGS[locale] ?? '🌐';

    // Switch dir for RTL locales
    const html = document.documentElement;
    if (RTL_LOCALES.has(locale)) {
      html.setAttribute('dir', 'rtl');
      html.setAttribute('lang', locale);
    } else {
      html.setAttribute('dir', 'ltr');
      html.setAttribute('lang', locale);
    }

    // Dynamic CJK font loading — only load Noto Sans SC when Chinese is active
    const CJK_FONT_ID = 'smiths-cjk-font';
    const existingLink = document.getElementById(CJK_FONT_ID);
    if (CJK_LOCALES.has(locale)) {
      if (!existingLink) {
        const link = document.createElement('link');
        link.id = CJK_FONT_ID;
        link.rel = 'stylesheet';
        link.href = 'https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&display=swap';
        document.head.appendChild(link);
      }
      html.style.fontFamily = '"Noto Sans SC", ' + getComputedStyle(html).fontFamily;
    } else {
      if (existingLink) existingLink.remove();
      html.style.fontFamily = '';
    }

    // Update active state in dropdown
    document.querySelectorAll('.locale-option').forEach((btn) => {
      const loc = (btn as HTMLElement).dataset.locale;
      btn.classList.toggle('active', loc === locale);
      btn.setAttribute('aria-selected', loc === locale ? 'true' : 'false');
      const check = btn.querySelector('.locale-check');
      if (check) check.remove();
      if (loc === locale) {
        const span = document.createElement('span');
        span.className = 'locale-check';
        span.textContent = '✓';
        btn.appendChild(span);
      }
    });
  }

  function init() {
    const picker = document.getElementById('locale-picker');
    const trigger = document.getElementById('locale-trigger');
    const dropdown = document.getElementById('locale-dropdown');
    if (!picker || !trigger || !dropdown) return;

    // Apply saved locale on page load
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved && saved !== 'en' && LOCALES[saved]) {
      applyLocale(saved);
    }

    // Toggle dropdown
    trigger.addEventListener('click', () => {
      const isOpen = picker.classList.toggle('open');
      trigger.setAttribute('aria-expanded', String(isOpen));
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!picker.contains(e.target as Node)) {
        picker.classList.remove('open');
        trigger.setAttribute('aria-expanded', 'false');
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        picker.classList.remove('open');
        trigger.setAttribute('aria-expanded', 'false');
      }
    });

    // Handle locale selection
    dropdown.querySelectorAll('.locale-option').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetLocale = (btn as HTMLElement).dataset.locale ?? 'en';
        localStorage.setItem(STORAGE_KEY, targetLocale);
        applyLocale(targetLocale);
        picker.classList.remove('open');
        trigger.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Run on initial load and on Astro page transitions
  init();
  document.addEventListener('astro:after-swap', init);
</script>

