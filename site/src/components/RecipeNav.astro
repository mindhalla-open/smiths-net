---
/**
 * <RecipeNav> — prev/next links at the bottom of each recipe.
 *
 * Links to adjacent recipes within the same track + lang, sorted by `order`.
 */
import { getCollection } from 'astro:content';

interface Props {
  currentId: string;
  track: string;
  lang: string;
}

const { currentId, track, lang } = Astro.props;

const allRecipes = await getCollection('cookbook');

// Filter to same track + lang, sort by order
const siblings = allRecipes
  .filter((r) => {
    const parts = r.id.split('/');
    return parts[0] === track && parts[1] === lang;
  })
  .sort((a, b) => a.data.order - b.data.order);

const currentIndex = siblings.findIndex((r) => r.id === currentId);
const prev = currentIndex > 0 ? siblings[currentIndex - 1] : null;
const next = currentIndex < siblings.length - 1 ? siblings[currentIndex + 1] : null;

function recipeHref(entry: typeof siblings[0]): string {
  const parts = entry.id.split('/');
  return `/cookbook/${parts[0]}/${parts[1]}/${parts[2]}/`;
}
---

{(prev || next) && (
  <nav class="recipe-nav" aria-label="Recipe pagination">
    {prev ? (
      <a href={recipeHref(prev)} class="recipe-nav-link recipe-nav-link--prev">
        <span class="recipe-nav-direction">← Previous</span>
        <span class="recipe-nav-title">{prev.data.title}</span>
      </a>
    ) : (
      <span />
    )}
    {next ? (
      <a href={recipeHref(next)} class="recipe-nav-link recipe-nav-link--next">
        <span class="recipe-nav-direction">Next →</span>
        <span class="recipe-nav-title">{next.data.title}</span>
      </a>
    ) : (
      <span />
    )}
  </nav>
)}

<style>
  .recipe-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .recipe-nav-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
    max-width: 50%;
  }

  .recipe-nav-link:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-hover);
    text-decoration: none;
  }

  .recipe-nav-link--next {
    text-align: right;
    margin-left: auto;
  }

  .recipe-nav-direction {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .recipe-nav-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .recipe-nav {
      flex-direction: column;
    }

    .recipe-nav-link {
      max-width: 100%;
    }

    .recipe-nav-link--next {
      text-align: left;
    }
  }
</style>
