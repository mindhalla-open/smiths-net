{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "smiths-net overview — SIP signaling, media, plugin, and control-plane at a glance. Panels are grouped by subsystem; every panel reads one or more metrics that the engine exposes on /metrics. Refresh 10s.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Dialogs & bridges (live)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sip_dialogs_active{instance=~\"$instance\"}", "legendFormat": "dialogs", "refId": "A"},
        {"expr": "media_bridges_active{instance=~\"$instance\"}", "legendFormat": "bridges", "refId": "B"}
      ]
    },
    {
      "title": "SIP requests / responses",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum by (method) (rate(sip_requests_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "req {{method}}", "refId": "A"},
        {"expr": "sum by (code) (rate(sip_responses_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "resp {{code}}", "refId": "B"}
      ]
    },
    {
      "title": "Server txn FSM entries",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sip_server_txns_active{instance=~\"$instance\"}", "legendFormat": "active", "refId": "A"}
      ]
    },
    {
      "title": "INVITE 2xx retransmits / min",
      "type": "timeseries",
      "description": "Per RFC 3261 §13.3.1.4 the TU retransmits 2xx until ACK. A slope change here is either lossy ACK paths or a UAC that's stopped ACKing.",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum(rate(sip_invite_2xx_retransmits_total{instance=~\"$instance\"}[5m])) * 60", "legendFormat": "retransmits/min", "refId": "A"}
      ]
    },
    {
      "title": "SIP parse errors",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "rate(sip_parse_errors_total{instance=~\"$instance\"}[$__rate_interval])", "legendFormat": "errors/s", "refId": "A"}
      ]
    },
    {
      "title": "RTP packets forwarded",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum by (direction) (rate(rtp_packets_forwarded_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{direction}}", "refId": "A"}
      ]
    },
    {
      "title": "RTCP SRs emitted",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "rate(rtcp_sr_sent_total{instance=~\"$instance\"}[$__rate_interval])", "legendFormat": "SRs/s", "refId": "A"}
      ]
    },
    {
      "title": "Plugin invocations",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum by (plugin, outcome) (rate(plugin_invocations_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{plugin}} / {{outcome}}", "refId": "A"}
      ]
    },
    {
      "title": "Plugin invoke latency (p95)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (plugin, le) (rate(plugin_invoke_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "{{plugin}}", "refId": "A"}
      ]
    },
    {
      "title": "Sidecar restarts",
      "type": "timeseries",
      "description": "Non-zero = sidecar crashed + supervisor respawned. Sustained rate is the first signal that a plugin is flaky or tripping the seccomp filter.",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum by (plugin) (rate(sidecar_restarts_total{instance=~\"$instance\"}[5m])) * 60", "legendFormat": "{{plugin}}", "refId": "A"}
      ]
    },
    {
      "title": "Tool invocations & latency",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 24},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum by (tool, outcome) (rate(tool_invocations_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{tool}} / {{outcome}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (tool, le) (rate(tool_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "{{tool}} p95", "refId": "B"}
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["smiths-net", "sip", "rtp", "overview"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {"text": "default", "value": "default"},
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": "label_values(up{job=\"smiths-net\"}, instance)",
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "smiths-net overview",
  "uid": "smiths-net-overview",
  "version": 1,
  "weekStart": ""
}
